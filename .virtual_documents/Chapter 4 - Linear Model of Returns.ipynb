    .plot(
        kind   = "bar",
        ylabel = r"$\alpha$",
        title  = r"$\alpha$" + " from OLS Regression"))





w        = alpha_perp / np.linalg.norm(alpha_perp)
port_rtn = (R @ w)


fig, axes = plt.subplots(figsize = (8,5))
(port_rtn
