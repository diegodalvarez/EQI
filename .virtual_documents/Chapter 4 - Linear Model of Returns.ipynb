        data = factor_dict[key], 
        ax   = ax)

    ax.set_xlabel("")
    ax.set_ylabel("")
    ax.set_title(key)

fig.suptitle(r"Comparison of $\beta$ factors vs new factors (via PCA of $\epsilon$) before they are orthogonalized")
